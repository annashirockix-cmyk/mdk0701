{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"settings": {
		"typography": {
			"fontFamilies": [
				
				{
					"fontFace": [
						{
							"fontFamily": "Wittgenstein",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/wittgenstein/wittgenstein-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Wittgenstein",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/wittgenstein/wittgenstein-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Wittgenstein",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/wittgenstein/wittgenstein-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Wittgenstein",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/wittgenstein/wittgenstein-700-italic.woff2"
							]
						}
					],
					"fontFamily": "Wittgenstein, serif",
					"name": "Wittgenstein",
					"slug": "wittgenstein"
				},
				
				{
					"fontFace": [
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-700-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Atkinson Hyperlegible\", sans-serif",
					"name": "Atkinson Hyperlegible",
					"slug": "atkinson-hyperlegible"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase"
				}
			},
			"core/page-list": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--wittgenstein)"
		}
	},
	"version": 3,
	"title": "Atkinson Hyperlegible + Wittgenstein"
}
