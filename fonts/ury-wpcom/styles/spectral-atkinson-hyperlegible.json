{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"settings": {
		"typography": {
			"fontFamilies": [
				
				{
					"fontFace": [
						{
							"fontFamily": "\"Quattrocento Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/quattrocento-sans/quattrocento-sans-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Quattrocento Sans\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/quattrocento-sans/quattrocento-sans-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Quattrocento Sans\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/quattrocento-sans/quattrocento-sans-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Quattrocento Sans\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/quattrocento-sans/quattrocento-sans-700-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Quattrocento Sans\", sans-serif",
					"name": "Quattrocento Sans",
					"slug": "quattrocento-sans"
				},
				
				{
					"fontFace": [
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/spectral/spectral-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/spectral/spectral-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/spectral/spectral-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/spectral/spectral-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/spectral/spectral-600-italic.woff2"
							]
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/spectral/spectral-700-italic.woff2"
							]
						}
					],
					"fontFamily": "Spectral, serif",
					"name": "Spectral",
					"slug": "spectral"
				},
				
				{
					"fontFace": [
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Atkinson Hyperlegible\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-700-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Atkinson Hyperlegible\", sans-serif",
					"name": "Atkinson Hyperlegible",
					"slug": "atkinson-hyperlegible"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)"
				}
			},
			"core/buttons": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--quattrocento-sans)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--spectral)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--spectral)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--atkinson-hyperlegible)"
		}
	},
	"version": 3,
	"title": "Spectral + Atkinson Hyperlegible"
}
